---

interface Props {
    title: string;
    description: string;
    level: number;
    id: string;
    projects: {
        title: string;
        description: string;
        argumentation: string;
        img: string;
        img_alt?: string;
        path: string;
    }[];
}

const { title, description, level, id, projects } = Astro.props;

---

<div class="competence-block">
    <button class="accordion-header" aria-expanded="false" aria-controls={`content-${id}`}>
        <div class="header-content">
            <h3>{title}</h3>
            <div class="level-indicator">
                <div class="level" style={`--level: ${level}`}>
                    <span>Niveau {level}</span>
                </div>
            </div>
        </div>
        <svg class="arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 9L12 15L18 9" stroke="var(--accent-regular)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
    <div class="accordion-content" id={`content-${id}`} role="region" hidden>
        <p class="description">{description}</p>
        <div class="projects">
            <h4>Projets associés</h4>
            {projects.length > 0 ? (
                projects.map(project => (
                    <div class="project">
                        <button class="accordion-project" aria-expanded="false" aria-controls={`content-${id}`}>
                          <div class="project-header">
                            <img src={project.img} alt={project.img_alt || ''} loading="lazy" decoding="async" />
                            <div class="header-content">
                              <h5>{project.title}</h5>
                              <p>{project.description}</p>
                            </div>
                          </div>
                          <svg class="arrow2" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M6 9L12 15L18 9" stroke="var(--accent-regular)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      <div class="argumentation">
                            <h6>Développement de la compétence</h6>
                            <p>{project.argumentation}</p>
                      </div>
                      <a class="btn" href={`/work/${project.path}`}>Voir le projet</a>
                    </div>
                ))
            ) : (
                <p class="no-projects">Aucun projet associé pour le moment</p>
            )}
        </div>
    </div>
</div>

<style>
    .competence-block {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        margin-bottom: 1rem;
        background: transparent;
    }

    .accordion-header, .accordion-project {
        width: 100%;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: none;
        border: none;
        cursor: pointer;
        text-align: left;
    }

    .accordion-project {
        width: 100%;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: none;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        cursor: pointer;
        text-align: left;
    }

    .project-header {
      display: flex;
      align-items: center;
      flex: 1;
      gap: 1rem;
    }
    .project-header img {
      width: 25%;
      height: auto;
    }
    .project-header p
    {
      color: var(--accent-regular);
    }
    .header-content {
        flex: 1;
    }

    .accordion-header h3 {
        margin: 0;
        font-size: 1.1rem;
    }

    .level-indicator {
        margin-top: 0.5rem;
        background: #eee;
        border-radius: 10px;
        height: 12px;
        position: relative;
        width: 97%;
    }

    .level {
        position: absolute;
        height: 100%;
        width: 100%;
        background: var(--accent-regular);
        border-radius: 10px;
        transition: width 0.3s ease;
    }

    .level span {
        position: absolute;
        right: 8px;
        color: white;
        font-size: 0.7rem;
        line-height: 12px;
    }

    .arrow {
        transition: transform 0.3s ease;
    }

    .accordion-header[aria-expanded="true"] .arrow {
        transform: rotate(180deg);
    }
    .accordion-project[aria-expanded="true"] .arrow2 {
        transform: rotate(180deg);
    }
    .accordion-content {
        padding: 0 1rem 1rem;
    }

    .accordion-content[hidden] {
        display: none;
    }

    .description {
        margin-bottom: 1.5rem;
    }

    .projects {
        border-top: 1px solid #e2e8f0;
        padding-top: 1rem;
    }

    .project {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: transparent;
        border-radius: 6px;
    }

    .project a {
        text-decoration: none;
        color: inherit;
    }

    .project h5 {
        margin: 0 0 0.5rem 0;
    }

    .argumentation {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px dashed #e2e8f0;
    }

    .argumentation h6 {
        color: var(--accent-regular);
        margin: 0 0 0.5rem 0;
    }

    .no-projects {
        font-style: italic;
    }
</style>