---

interface Props {
    title: string;
    description: string;
    level: number;
    id: string;
    projects: {
        title: string;
        description: string;
        argumentation: string;
        img: string;
        img_alt?: string;
        path: string;
    }[];
}

const { title, description, level, id, projects } = Astro.props;

---

<div class="competence-block">
    <button class="accordion-header" aria-expanded="false" aria-controls={`content-${id}`}>
        <div class="header-content">
            <h3>{title}</h3>
            <div class="level-indicator">
                <div class="level" style={`--level: ${level}`}>
                    <span>Niveau {level}</span>
                </div>
            </div>
        </div>
        <svg class="arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 9L12 15L18 9" stroke="var(--accent-regular)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
    <div class="accordion-content" id={`content-${id}`} role="region" hidden>
        <p class="description">{description}</p>
        <div class="projects">
            <h4>Projets associés</h4>
            {projects.length > 0 ? (
                projects.map((project, index) => (
                    <div class="accordion">
                        <button class="accordion-project" 
                                aria-expanded="false" 
                                aria-controls={`argumentation-${id}-${index}`}>
                            <img src={project.img} alt={project.img_alt || ''} loading="lazy" decoding="async" />
                            <div class="header-content">
                                <h5>{project.title}</h5>
                                <p>{project.description}</p>
                            </div>
                            <svg class="arrow2" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M6 9L12 15L18 9" stroke="var(--accent-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <div class="argumentation" id={`argumentation-${id}-${index}`} role="region" hidden>
                            <div class="argumentation-content">
                                <h6>Développement de la compétence</h6>
                                <p>{project.argumentation}</p>
                                <a class="btn" href={`/work/${project.path}`}>Voir le projet</a>
                            </div>
                        </div>
                    </div>
                ))
            ) : (
                <p class="no-projects">Aucun projet associé pour le moment</p>
            )}
        </div>
    </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const projectButtons = document.querySelectorAll('.accordion-project');
    
    projectButtons.forEach(button => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', (!isExpanded).toString());
        
        const argumentationId = button.getAttribute('aria-controls');
        if (!argumentationId) return;
        const argumentation = document.getElementById(argumentationId);
        if (argumentation) {
          argumentation.hidden = isExpanded;
        }
      });
    });
  });
</script>

<style>
    .competence-block {
        border: 1px solid var(--gray-300);
        border-radius: 8px;
        margin-bottom: 1rem;
        background: transparent;
    }

    .accordion-header {
        width: 100%;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: none;
        border: none;
        cursor: pointer;
        text-align: left;
    }

    .accordion {
        margin-top: 1.5rem;
        display: flex;
        flex-direction: column;
        background: transparent;
    }

    .accordion-project {
        width: 100%;
        display: grid;
        grid-template-columns: 25% 1fr auto;
        gap: 1rem;
        align-items: center;
        background: var(--accent-regular);
        cursor: pointer;
        border: none;
        padding: 0;
    }

    .accordion-project[aria-expanded="false"] {
        border-radius: 8px;
    }

    .accordion-project[aria-expanded="true"] {
        border-bottom: none;
        border-radius: 8px 8px 0 0;
    }

    
    .accordion-project img {
        width: 100%; /* Prend toute la largeur de sa colonne */
        height: 100%; /* Prend toute la hauteur */
        object-fit: cover;
        display: block;
    }
    .project-header p
    {
      color: var(--accent-regular);
    }
    .header-content {
        padding: 0.5rem 0; 
        display: flex;
        flex-direction: column;
        text-align: left;
    }
    .header-content p {
        color: var(--accent-text-over);
    }

    .accordion-header h3 {
        margin: 0;
        font-size: 1.1rem;
    }
    .accordion-header .header-content {
    flex: 1;
    padding-right: 1rem; /* Ajoute l'espace pour la flèche */
    }
    
    .level-indicator {
        margin-top: 0.5rem;
        background: #eee;
        border-radius: 10px;
        height: 12px;
        position: relative;
        width: 100%;
    }

    .level {
        position: absolute;
        height: 100%;
        width: 100%;
        background: var(--gradient-accent);
        border-radius: 10px;
        transition: width 0.3s ease;
    }

    .level span {
        position: absolute;
        right: 8px;
        color: white;
        font-size: 0.7rem;
        line-height: 12px;
    }

    .arrow {
        transition: transform 0.3s ease;
    }

    .accordion-header[aria-expanded="true"] .arrow {
        transform: rotate(180deg);
    }
    .accordion-project[aria-expanded="true"] .arrow2 {
        transform: rotate(180deg);
    }
    .accordion-content, .argumentation {
        padding: 0 1rem 1rem;
    }

    .accordion-content[hidden] {
        display: none;
    }

    .argumentation[hidden] {
        display: none;
    }

    .description {
        margin-bottom: 1.5rem;
    }

    .projects {
        border-top: 1px solid var(--gray-300);
        padding-top: 1rem;
    }

    .header-content h5 {
        margin: 0 0 0.5rem 0;
        color: #FFFFFF;
    }

    .argumentation {
        background: transparent;
        margin: 0;
        border-top: dashed 1px var(--gray-100);
    }

    .argumentation-content {
        padding: 1rem;
        flex: 1;
    }

    .argumentation h6 {
        color: var(--accent-regular);
        margin: 0 0 0.5rem 0;
    }

    .no-projects {
        font-style: italic;
    }

    .accordion {
        border: 1px solid var(--gray-300);
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 1rem;
    }
    .btn{
		position: relative;
		display: flex;
		place-content: center;
		text-align: center;
		padding: 0.56em 2em;
		gap: 0.8em;
		color: var(--accent-text-over);
		text-decoration: none;
		line-height: 1.1;
		border-radius: 999rem;
		overflow: hidden;
		background: var(--gradient-accent-orange);
		box-shadow: var(--shadow-md);
		white-space: nowrap;
        width: fit-content;
        margin: 0;
        margin-top: 1rem;
        margin-left: auto;
    	}

	@media (min-width: 20em) {
		a {
			font-size: var(--text-md);
		}
	}

	/* Overlay for hover effects. */
	a::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		transition: background-color var(--theme-transition);
		mix-blend-mode: overlay;
	}

	a:focus::after,
	a:hover::after {
		background-color: hsla(var(--gray-999-basis), 0.3);
	}

	@media (min-width: 50em) {
		a {
			padding: 1.125rem 2.5rem;
			font-size: var(--text-lg);
		}
	}
    .arrow2 {
        margin-right: 1rem;
        align-self: center; // Add vertical centering
    }

    @media screen and (max-width: 48em) {
        .accordion-project {
            grid-template-columns: 30% 1fr auto;
        }
    }

    @media screen and (max-width: 30em) {
        .accordion-project {
            grid-template-columns: 35% 1fr auto;
        }
    }
</style>